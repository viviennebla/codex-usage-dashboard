  "author": {
    "name": "viviennebla"
  },
  "repository": "https://github.com/viviennebla/codex-usage-dashboard",
  "license": "MIT",
  "keywords": [
    "codex",
    "usage",
    "leaderboard",
    "vibe-coding"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "蹬了吗",
