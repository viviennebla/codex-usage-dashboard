{
  "description": "Refresh the local Denglema snapshot at most once per hour while Codex is in use. Never uploads automatically.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/collect-if-due.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/collect-if-due.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
